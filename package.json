{
  "name": "purple-memo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify": "node scripts/check-hooks.mjs && node scripts/check-references.mjs && node scripts/check-signing-key.mjs && node scripts/check-android-apk.mjs && node scripts/check-android-manifest.mjs && node scripts/check-versions.mjs && npm run lint && npm run token-lint && npm run dead-code && npm run typecheck && npm run test && npm run test:rust && npm run clippy && npm run fmt:check && npm run check:android && npm run build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "token-lint": "node scripts/token-lint.mjs",
    "dead-code": "node scripts/dead-code.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:references": "node scripts/check-references.mjs",
    "check:signing-key": "node scripts/check-signing-key.mjs",
    "check:android": "node scripts/check-android-target.mjs",
    "check:android-apk": "node scripts/check-android-apk.mjs",
    "check:android-manifest": "node scripts/check-android-manifest.mjs",
    "setup:android-make-shim": "node scripts/android-make-shim/setup.mjs",
    "clippy": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-notification": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-updater": "2.13.3",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
