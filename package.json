{
  "name": "purple-memo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify": "node scripts/check-hooks.mjs && node scripts/check-versions.mjs && npm run lint && npm run token-lint && npm run typecheck && npm run test && npm run test:rust && npm run clippy && npm run fmt:check && npm run build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "token-lint": "node scripts/token-lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-notification": "2.6.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-updater": "2.13.3",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
