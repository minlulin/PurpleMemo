# Normalize line endings; scripts must be LF.
# POSIX sh chokes on CRLF shebangs (`#!/bin/sh\r`) even though
# Git-for-Windows tolerates them — pin every executable script to LF.
* text=auto
.githooks/* text eol=lf
*.sh text eol=lf
# Biome's formatter requires LF; a CRLF checkout of a JSON config fails
# the gate (plan §7). Pin the configs it checks so fresh clones stay LF.
*.json text eol=lf
