# Dependencies & builds
node_modules/
dist/
target/

# The Windows Android cross-compile pieces `npm run setup:android-toolchain`
# installs — the make shim and the pruned perl module tree. Built artefacts,
# not source; the gate discovers them here so they survive a %TEMP% cleanup.
.android-toolchain/

# Generated Tauri ACL schemas (rebuilt on every build) — never committed
src-tauri/gen/schemas/

# Generated Apple projects are unused by this project
src-tauri/gen/apple/

# The generated Android Studio project IS committed (curated, decision 2026-11-02).
# Its build outputs, local SDK paths and signing material are excluded by the
# project's own ignore file (src-tauri/gen/android/.gitignore), which covers
# build/, .gradle/, local.properties, key.properties, keystore.properties and
# the per-build tauri.* glue files.

# Signing keys — never committed
.keys/

# The updater manifest is a release artifact, not source (audit A7).
# `scripts/make-latest-json.mjs` writes it next to the built installer inside
# `target/`; this entry stops a hand-passed `--out latest.json` from being
# committed as a second manifest with the same name as the served one.
/latest.json

# Logs & local state
*.log
*.local

# OS / editor noise
.DS_Store
Thumbs.db

# agent scratch (ledger, briefs, review packages)
.superpowers/
/.freebuff

# MSVC build artifacts
ossl_static.pdb

# Audit reports live outside the tree, like the review documents removed in
# aa8a6cf and f6b2ba3 ("archived as mementos outside"). The fixes are the
# commits; the report itself is a memento.
/audit_report.md
